# An example of deadline_agent/.env. setup.sh (Linux and macOS) and
# setup_windows.bat create the real .env for you. To make it by hand, copy
# this file to .env in this folder and put your own Gemini API key below.
# Never commit .env, it holds your key (.gitignore already leaves it out).

# 0 means use the Gemini API from Google AI Studio, not Google Cloud.
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=paste-your-gemini-api-key-here
